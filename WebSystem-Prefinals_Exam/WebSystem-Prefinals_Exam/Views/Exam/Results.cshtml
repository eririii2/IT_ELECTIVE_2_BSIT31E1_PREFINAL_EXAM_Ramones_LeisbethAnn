@model WebSystem_Prefinals_Exam.Models.ExamViewModel

@{
    ViewData["Title"] = "Exam Results";
}

<div class="exam-page">

    <div class="exam-header">

        <div class="yellow-bar"></div>

        <div class="header-content">

            <h1>Examination Results</h1>

            <p class="exam-subtitle">
                IT Elective 2 – Web System and Technologies
            </p>


            <div class="student-result">

                <p>
                    <strong>Name:</strong>
                    @Model.StudentName
                </p>

                <p>
                    <strong>Class:</strong>
                    @Model.ClassName
                </p>

                <p>
                    <strong>Section:</strong>
                    @Model.Section
                </p>

            </div>

        </div>

    </div>

    <div class="score-card">

        <p class="score-title">
            Your Score
        </p>

        <div class="score-number">
            @Model.Score / @Model.TotalQuestions
        </div>

        <div class="score-percentage">
            @Model.Percentage.ToString("0")%
        </div>


        @if (Model.Percentage >= 75)
        {
            <div class="passed-message">
                Congratulations! You passed the examination.
            </div>
        }
        else
        {
            <div class="failed-message">
                You did not reach the passing score. Keep studying!
            </div>
        }

    </div>

    <h2 class="answers-title">
        Answer Review
    </h2>


    @foreach (var question in Model.Questions)
    {
        bool correct =
        question.SelectedAnswer == question.CorrectAnswer;

        <div class="question-card result-card">

            <h2>
                @question.Id. @question.Text
            </h2>


            @foreach (var choice in question.Choices)
            {
                string letter = choice.Substring(0, 1);

                bool isCorrectChoice =
                letter == question.CorrectAnswer;

                bool isSelectedChoice =
                letter == question.SelectedAnswer;

                string choiceClass = "";

                if (isCorrectChoice)
                {
                    choiceClass = "correct-choice";
                }
                else if (isSelectedChoice)
                {
                    choiceClass = "wrong-choice";
                }

                <div class="result-choice @choiceClass">

                    <span class="result-letter">
                        @letter
                    </span>

                    <span>
                        @choice.Substring(3)
                    </span>

                    @if (isCorrectChoice)
                    {
                        <span class="answer-label">
                            ✓ Correct Answer
                        </span>
                    }
                    else if (isSelectedChoice)
                    {
                        <span class="answer-label">
                            ✗ Your Answer
                        </span>
                    }

                </div>
            }


            <div class="question-result">

                @if (correct)
                {
                    <span class="correct-text">
                        ✓ Correct
                    </span>
                }
                else
                {
                    <span class="wrong-text">
                        ✗ Incorrect
                    </span>
                }

            </div>

        </div>
    }

    <div class="submit-area">

        <a asp-controller="Exam"
           asp-action="Index"
           class="submit-button">

            Take Examination Again

        </a>

    </div>

</div>